    "test:coverage": "npm run test",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "keywords": [
    "cypress",
    "karate",
    "api-testing",
    "ui-testing",
    "bdd",
    "gherkin",
    "quality-engineering",
    "test-automation"
